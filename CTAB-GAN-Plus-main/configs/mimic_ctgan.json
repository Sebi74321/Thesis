{
  "base_config": "mimic_ctabgan.json",
  "generator_name": "ctgan",
  "smoke_batch_size": 50,
  "generator": {
    "categorical_columns": ["gender", "hospital_expire_flag"],
    "embedding_dim": 128,
    "generator_dim": [256, 256],
    "discriminator_dim": [256, 256],
    "generator_lr": 0.0002,
    "discriminator_lr": 0.0002,
    "batch_size": 500,
    "discriminator_steps": 1,
    "log_frequency": true,
    "verbose": true,
    "epochs": 150,
    "pac": 10
  }
}
