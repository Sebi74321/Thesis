{
  "base_config": "mimic_ctabgan.json",
  "generator_name": "dp_cgan",
  "smoke_batch_size": 50,
  "generator": {
    "categorical_columns": ["gender", "hospital_expire_flag"],
    "generator_dim": [128, 128, 128],
    "discriminator_dim": [128, 128, 128],
    "generator_lr": 0.0002,
    "discriminator_lr": 0.0002,
    "batch_size": 500,
    "discriminator_steps": 10,
    "log_frequency": true,
    "verbose": true,
    "epochs": 150,
    "pac": 10,
    "private": false,
    "saved_transformer": null,
    "dequantize_integer_features": true,
    "dequantization_half_width": 0.5,
    "dequantization_modal_values": {"spo2_max": [100.0]},
    "reuse_transformer_across_variants": true
  }
}
